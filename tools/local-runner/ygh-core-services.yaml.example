# Copy this file outside the repository, for example:
# E:/ygh-secrets/env/ygh-core-services.yaml
# Do not commit the real file with passwords or keys.
#
# This runner accepts a flat YAML mapping only: KEY: value
# Keep secret values in the copied file, not in this example.

YGH_NACOS_SERVER_ADDR: 192.168.220.171:8848
YGH_NACOS_NAMESPACE: ygh-dev
YGH_NACOS_DISCOVERY_GROUP: YGH_GROUP
YGH_NACOS_USERNAME: nacos
YGH_NACOS_PASSWORD: replace-me

YGH_REDIS_HOST: 192.168.220.171
YGH_REDIS_PORT: 6379
YGH_REDIS_PASSWORD: replace-me
YGH_REDIS_ENVIRONMENT: dev

YGH_AUTH_PORT: 8081
YGH_USER_PORT: 8082
YGH_SYSTEM_PORT: 8083
YGH_PRODUCT_PORT: 8084
YGH_KNOWLEDGE_PORT: 8085
YGH_INVENTORY_PORT: 8086

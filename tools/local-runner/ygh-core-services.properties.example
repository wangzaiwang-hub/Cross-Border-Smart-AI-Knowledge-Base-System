# Copy this file outside the repository, for example:
# E:/ygh-secrets/env/ygh-core-services.properties
# Do not commit the real file with passwords or keys.

YGH_NACOS_SERVER_ADDR=192.168.220.171:8848
YGH_NACOS_NAMESPACE=ygh-dev
YGH_NACOS_DISCOVERY_GROUP=YGH_GROUP
YGH_NACOS_USERNAME=nacos
YGH_NACOS_PASSWORD=replace-me

YGH_REDIS_HOST=192.168.220.171
YGH_REDIS_PORT=6379
YGH_REDIS_PASSWORD=replace-me
YGH_REDIS_ENVIRONMENT=dev

YGH_AUTH_PORT=8081
YGH_USER_PORT=8082
YGH_SYSTEM_PORT=8083

YGH_AUTH_DB_URL=jdbc:mysql://192.168.220.171:3306/auth_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
YGH_AUTH_DB_APP_USERNAME=ygh_auth_app
YGH_AUTH_DB_APP_PASSWORD=replace-me
YGH_AUTH_DB_MIGRATION_USERNAME=ygh_auth_migration
YGH_AUTH_DB_MIGRATION_PASSWORD=replace-me

YGH_USER_DB_URL=jdbc:mysql://192.168.220.171:3306/user_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
YGH_USER_DB_APP_USERNAME=ygh_user_app
YGH_USER_DB_APP_PASSWORD=replace-me
YGH_USER_DB_MIGRATION_USERNAME=ygh_user_migration
YGH_USER_DB_MIGRATION_PASSWORD=replace-me

YGH_SYSTEM_DB_URL=jdbc:mysql://192.168.220.171:3306/system_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
YGH_SYSTEM_DB_APP_USERNAME=ygh_system_app
YGH_SYSTEM_DB_APP_PASSWORD=replace-me
YGH_SYSTEM_DB_MIGRATION_USERNAME=ygh_system_migration
YGH_SYSTEM_DB_MIGRATION_PASSWORD=replace-me

YGH_AUTH_ID_WORKER=1
YGH_USER_ID_WORKER=2
YGH_USER_PII_KEY_VERSION=1

YGH_INTERNAL_REQUEST_HMAC_BASE64=replace-me
YGH_AUTH_AUDIT_PEPPER_BASE64=replace-me
YGH_USER_PII_KEY_BASE64=replace-me
YGH_SYSTEM_CONFIG_MASTER_KEY_BASE64=replace-me

YGH_SYSTEM_INTERNAL_BASE_URL=http://127.0.0.1:8083

YGH_JWT_ENABLED=true
YGH_JWT_KEY_DIRECTORY=E:/ygh-secrets/jwt
YGH_JWT_ACTIVE_KID=auth-dev-2026
YGH_JWT_ISSUER=ygh-auth-dev
YGH_JWT_AUDIENCE=ygh-api

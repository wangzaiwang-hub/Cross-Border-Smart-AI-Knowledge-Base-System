meta { name: Refresh Token type: http seq: 3 }
post { url: {{baseUrl}}/api/v1/auth/refresh body: json auth: none }
body:json { {"refreshToken":"{{refreshToken}}","deviceId":"bruno"} }
script:post-response { if (res.body?.data?.accessToken) { bru.setEnvVar("accessToken", res.body.data.accessToken); bru.setEnvVar("refreshToken", res.body.data.refreshToken); } }

meta { name: Captcha type: http seq: 1 }
get { url: {{baseUrl}}/api/v1/auth/captcha body: none auth: none }
script:post-response { if (res.body?.data?.challengeId) bru.setEnvVar("captchaChallengeId", res.body.data.challengeId); }
tests { test("captcha envelope", function () { expect(res.body.data).to.have.property("imageBase64"); }); }

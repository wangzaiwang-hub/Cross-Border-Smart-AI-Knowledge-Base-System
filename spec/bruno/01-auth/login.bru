meta { name: Login type: http seq: 1 }
post { url: {{baseUrl}}/api/v1/auth/login body: json auth: none }
body:json { {"principal":"demo@example.com","password":"replace-at-runtime","deviceId":"bruno"} }
script:post-response { if (res.body?.data?.accessToken) bru.setEnvVar("accessToken", res.body.data.accessToken); }
tests { test("successful envelope", function () { expect(res.body).to.have.property("traceId"); }); }

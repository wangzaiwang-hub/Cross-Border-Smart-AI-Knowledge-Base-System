{
  "openapi": "3.1.0",
  "info": {
    "title": "YGH Authentication API",
    "description": "跨境智汇认证服务；所有外部业务路径固定为 /api/v1/auth/**",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Gateway relative base URL"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "register",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAuthenticationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "refresh",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTokenResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/password-reset/request": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "requestPasswordReset",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "202": {
            "description": "Accepted",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePasswordResetRequestedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "confirmPasswordReset",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOperationResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "logout",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/X-Request-Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOperationResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "login",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAuthenticationResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/captcha": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "captcha",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-Id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCaptchaResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "jwks-controller"
        ],
        "operationId": "keys",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-Id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/DependencyUnavailable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "principal": {
            "type": "string",
            "maxLength": 190,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "writeOnly": true
          },
          "confirmPassword": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "writeOnly": true
          },
          "captchaChallengeId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          "captchaAnswer": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0,
            "writeOnly": true
          },
          "agreementAccepted": {
            "type": "boolean"
          }
        },
        "required": [
          "captchaAnswer",
          "captchaChallengeId",
          "confirmPassword",
          "password",
          "principal"
        ]
      },
      "ApiResponseAuthenticationResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AuthenticationResponse"
          },
          "traceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthenticationResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenResponse"
          }
        },
        "required": [
          "tokens",
          "userId"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "refreshToken": {
            "type": "string",
            "minLength": 1
          },
          "tokenType": {
            "type": "string",
            "minLength": 1
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "refreshExpiresIn": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType"
        ]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 0,
            "writeOnly": true
          },
          "deviceId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ApiResponseTokenResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/TokenResponse"
          },
          "traceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "principal": {
            "type": "string",
            "maxLength": 190,
            "minLength": 0
          },
          "captchaChallengeId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          "captchaAnswer": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0,
            "writeOnly": true
          }
        },
        "required": [
          "captchaAnswer",
          "captchaChallengeId",
          "principal"
        ]
      },
      "ApiResponsePasswordResetRequestedResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PasswordResetRequestedResponse"
          },
          "traceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PasswordResetRequestedResponse": {
        "type": "object",
        "properties": {
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PasswordResetConfirmRequest": {
        "type": "object",
        "properties": {
          "resetToken": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 0,
            "writeOnly": true
          },
          "newPassword": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "writeOnly": true
          },
          "confirmPassword": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "writeOnly": true
          }
        },
        "required": [
          "confirmPassword",
          "newPassword",
          "resetToken"
        ]
      },
      "ApiResponseOperationResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/OperationResponse"
          },
          "traceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OperationResponse": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "boolean"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 0,
            "writeOnly": true
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "principal": {
            "type": "string",
            "maxLength": 190,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0,
            "writeOnly": true
          },
          "captchaChallengeId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          "captchaAnswer": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0,
            "writeOnly": true
          },
          "deviceId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          }
        },
        "required": [
          "password",
          "principal"
        ]
      },
      "ApiResponseCaptchaResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/CaptchaResponse"
          },
          "traceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CaptchaResponse": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "imageBase64": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "稳定业务错误码"
          },
          "message": {
            "type": "string",
            "description": "可安全展示的消息"
          },
          "data": {
            "description": "业务数据；失败时通常为空"
          },
          "traceId": {
            "type": "string",
            "description": "链路追踪标识"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "data",
          "message",
          "timestamp",
          "traceId"
        ]
      },
      "FieldValidationError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "rejectedValue": {
            "description": "始终为空，避免敏感输入泄漏"
          }
        },
        "required": [
          "field",
          "message",
          "rejectedValue"
        ]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldValidationError"
            }
          },
          "traceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "data",
          "message",
          "timestamp",
          "traceId"
        ]
      }
    },
    "responses": {
      "ValidationError": {
        "description": "参数校验失败",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未登录或登录已失效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "无权执行该操作",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "业务状态冲突",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "请求过于频繁",
        "headers": {
          "Retry-After": {
            "description": "客户端重试前至少等待的秒数",
            "schema": {
              "type": "string",
              "pattern": "[1-9][0-9]*"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      },
      "DependencyUnavailable": {
        "description": "依赖服务暂不可用",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "系统内部错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      }
    },
    "parameters": {
      "X-Request-Id": {
        "name": "X-Request-Id",
        "in": "header",
        "description": "客户端请求标识；缺失或不安全时由服务生成",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 128,
          "pattern": "[A-Za-z0-9._-]{1,128}"
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
